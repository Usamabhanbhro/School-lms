// School LMS — database schema (SRS v5).
// Three login roles: ADMIN (single account), TEACHER (multiple), ACADEMICS (multiple).
// Students are data records, not logins. No Parent access.
// See SCHEMA.md for entity rationale and relationships.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  ACADEMICS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum CertificateType {
  LEAVING
  CHARACTER
}

enum DocumentTemplateType {
  LEAVING_CERTIFICATE
  CHARACTER_CERTIFICATE
  REPORT_CARD
  FEE_CHALLAN
}

// ─── Auth / Identity ─────────────────────────────────────────────────

/// Login identity. Exactly one row with role = ADMIN should ever exist
/// (enforced by a partial unique index in the database — see migration 20260819000001).
/// Multiple rows with role = TEACHER or ACADEMICS.
model User {
  id           String  @id @default(cuid())
  username     String  @unique
  email        String? @unique
  name         String
  passwordHash String
  role         Role
  isActive     Boolean @default(true)

  /// Admin-only: hash of the current one-time recovery code. Null for Teacher/Academics.
  recoveryCodeHash String?

  recoveryCodes AdminRecoveryCode[]

  teacherProfile   TeacherProfile?
  academicsProfile AcademicsProfile?

  // Teacher attendance records this user (Admin) has marked
  markedTeacherAttendance TeacherAttendance[]

  // Tests created by this user (subject teacher)
  testsCreated Test[] @relation("TestTeacher")

  // Terms created by this user (teacher)
  termsCreated Term[] @relation("TermCreator")

  // Report cards generated by this user (teacher)
  reportCardsGenerated ReportCard[] @relation("ReportCardGenerator")

  // Fee challans generated by this user (admin or academics)
  feeChallansGenerated FeeChallan[] @relation("ChallanGenerator")

  // Certificates generated by this user (admin or academics)
  certificatesGenerated Certificate[] @relation("CertificateGenerator")

  // Document templates uploaded by this user (admin only)
  uploadedTemplates DocumentTemplate[]

  // Attendance audit logs edited by this user
  attendanceEdits AttendanceAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One-time recovery code for Admin self-service password recovery.
/// Many historical records per Admin; only one active code at a time.
/// A code is active only if consumedAt IS NULL AND replacedAt IS NULL.
model AdminRecoveryCode {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash     String // bcrypt hash of the plaintext recovery code
  expiresAt    DateTime? // deprecated: no longer enforced — codes are valid until used or manually regenerated
  consumedAt   DateTime?
  replacedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, consumedAt, replacedAt])
}

/// Academics-specific fields, kept separate from User (mirrors TeacherProfile pattern).
model AcademicsProfile {
  id        String  @id @default(cuid())
  name      String
  cnic      String  @unique // format: xxxxx-xxxxxxx-x
  phone     String  // format: 03xx-xxxxxxx
  email     String?
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Teacher-specific fields, kept separate from User so User stays a clean
/// auth/identity table.
model TeacherProfile {
  id                 String  @id @default(cuid())
  name               String
  fatherOrSpouseName String
  cnic               String  @unique // format: xxxxx-xxxxxxx-x
  phone              String  // format: 03xx-xxxxxxx
  email              String?
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  classTeacherAssignments ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]

  // Attendance records this teacher has marked (as class teacher)
  studentAttendanceMarked StudentAttendance[]
  // Attendance records where this teacher is the tracked subject
  teacherAttendanceRecords TeacherAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Academic Structure ──────────────────────────────────────────────

/// A specific class + section (e.g. "Grade 5 - A"). Created by Admin.
model ClassSection {
  id          String @id @default(cuid())
  className   String // e.g. "Grade 5"
  sectionName String // e.g. "A"

  students             Student[]
  classTeacherAssignments ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  studentAttendance    StudentAttendance[]
  tests                Test[]
  reportCards          ReportCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A subject (e.g. "Mathematics"). Global to the school, not per-class.
/// A SubjectTeacherAssignment ties a Subject to a specific ClassSection + Teacher.
model Subject {
  id   String @id @default(cuid())
  name String @unique

  subjectTeacherAssignments SubjectTeacherAssignment[]
  tests                     Test[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Tracks class teacher assignments over time. Only one row per ClassSection
/// should have isActive = true at any time. Reassigning soft-deletes the old
/// (sets isActive = false) and creates a new active row.
model ClassTeacherAssignment {
  id             String      @id @default(cuid())
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  isActive       Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classSectionId, isActive])
}

/// A teacher assigned to teach one Subject within one ClassSection.
/// Holds rights to create tests, enter marks, and generate report cards.
model SubjectTeacherAssignment {
  id             String      @id @default(cuid())
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  tests Test[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classSectionId, subjectId, teacherId])
}

// ─── Students ────────────────────────────────────────────────────────

/// Created by Admin, allotted to a ClassSection. NOT a login — pure data record.
model Student {
  id              String      @id @default(cuid())
  name            String
  guardianName    String      // father/guardian name
  guardianCnic    String      // format: xxxxx-xxxxxxx-x (student has no CNIC of their own)
  dateOfBirth     DateTime    @db.Date
  admissionDate   DateTime    @db.Date
  classSectionId  String
  classSection    ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Restrict)

  /// Admin/ACADEMICS-assigned student identifier (e.g. STD-2026-001). Nullable for existing records.
  studentId       String?     @unique
  /// Admin/ACADEMICS-assigned roll number, unique within class section. Nullable for existing records.
  rollNumber      String?

  attendance      StudentAttendance[]
  marks           Mark[]
  reportCards     ReportCard[]
  certificates    Certificate[]
  feeChallans     FeeChallan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classSectionId, rollNumber], name: "Student_classSection_rollNumber_unique")
}

// ─── Attendance ──────────────────────────────────────────────────────

/// One record per student per class per day. Only the ClassSection's active
/// Class Teacher can create/edit these (pre-lock). Highest-traffic table.
model StudentAttendance {
  id             String      @id @default(cuid())
  studentId      String
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  date           DateTime    @db.Date
  status         AttendanceStatus
  isConfirmed    Boolean     @default(false) // draft vs locked
  markedByTeacherId String
  markedByTeacher TeacherProfile @relation(fields: [markedByTeacherId], references: [id], onDelete: Restrict)

  /// Set if Admin overrides a locked record (SRS 1.5)
  lastEditedByAdmin String?

  /// Audit trail for edits
  auditLogs AttendanceAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classSectionId, date])
  @@index([classSectionId, date])
}

/// One record per teacher per day, marked directly by Admin.
/// No draft/confirm lock — Admin already has full edit rights.
model TeacherAttendance {
  id        String   @id @default(cuid())
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  status    AttendanceStatus

  /// The Admin user who marked/edited this record (nullable for historical data)
  markedById String?
  markedBy   User?    @relation(fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, date])
}

// ─── Tests & Marks ───────────────────────────────────────────────────

/// Created by a Subject Teacher, scoped to one ClassSection + Subject.
model Test {
  id                     String      @id @default(cuid())
  classSectionId         String
  classSection           ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  subjectId              String
  subject                Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId              String
  teacher                User        @relation("TestTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  subjectTeacherAssignmentId String?
  subjectTeacherAssignment SubjectTeacherAssignment? @relation(fields: [subjectTeacherAssignmentId], references: [id], onDelete: SetNull)
  title                  String
  date                   DateTime    @db.Date
  maxMarks               Int

  marks          Mark[]
  reportCardTests ReportCardTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A student's score on a specific Test. Numeric for tabular-figure display.
model Mark {
  id            String  @id @default(cuid())
  testId        String
  test          Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marksObtained Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, studentId])
}

// ─── Report Cards ────────────────────────────────────────────────────

/// A flexible, freely-named label (e.g. "Mid Term"). Created on the fly
/// by a teacher at report-card-generation time — not pre-defined by Admin.
model Term {
  id                 String  @id @default(cuid())
  name               String
  createdByTeacherId String
  createdByTeacher   User    @relation("TermCreator", fields: [createdByTeacherId], references: [id], onDelete: Restrict)

  reportCards ReportCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Aggregates a teacher-selected subset of Tests into one report for a student.
model ReportCard {
  id                     String      @id @default(cuid())
  studentId              String
  student                Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSectionId         String
  classSection           ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  termId                 String
  term                   Term        @relation(fields: [termId], references: [id], onDelete: Restrict)
  generatedByTeacherId   String
  generatedByTeacher     User        @relation("ReportCardGenerator", fields: [generatedByTeacherId], references: [id], onDelete: Restrict)
  templateId             String?     // snapshot of which template version was active when generated
  template               DocumentTemplate? @relation(fields: [templateId], references: [id])

  reportCardTests ReportCardTest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Join table: which tests were included in a particular report card aggregate.
model ReportCardTest {
  id           String     @id @default(cuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  testId       String
  test         Test       @relation(fields: [testId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportCardId, testId])
}

// ─── Certificates ────────────────────────────────────────────────────

/// Generated by Admin or Academics, per student. Layout/design deferred (SRS §1.8, §1A.1).
model Certificate {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type             CertificateType
  generatedByUserId String
  generatedByUser  User     @relation("CertificateGenerator", fields: [generatedByUserId], references: [id], onDelete: Restrict)
  issuedDate       DateTime @default(now())
  templateId       String?  // snapshot of which template version was active when generated
  template         DocumentTemplate? @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Fee Challan ─────────────────────────────────────────────────────

/// School-wide singleton, editable by Admin in the "Fees" tab.
/// Only one row should exist.
model BankSettings {
  id                String @id @default(cuid())
  bankName          String
  bankAccountNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Generated by Admin or Academics for one Student. Snapshots bank + student details
/// at generation time. Immutable once saved — regenerating creates a new challan.
model FeeChallan {
  id                     String   @id @default(cuid())
  studentId              String
  student                Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // Snapshotted student details (historical accuracy)
  studentNameSnapshot    String
  guardianNameSnapshot   String
  guardianCnicSnapshot   String
  classSectionSnapshot   String   // e.g. "Grade 5 - A" as text, not a live FK

  // Snapshotted bank details (historical accuracy)
  bankNameSnapshot       String
  bankAccountNumberSnapshot String

  generatedByUserId      String
  generatedByUser        User     @relation("ChallanGenerator", fields: [generatedByUserId], references: [id], onDelete: Restrict)
  issuedDate             DateTime @default(now())
  total                  Int      // computed sum of line items
  templateId             String?  // snapshot of which template version was active when generated
  template               DocumentTemplate? @relation(fields: [templateId], references: [id])

  lineItems              FeeChallanLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single fee component on a challan — base fee, arrears, late fee, etc.
model FeeChallanLineItem {
  id           String     @id @default(cuid())
  feeChallanId String
  feeChallan   FeeChallan @relation(fields: [feeChallanId], references: [id], onDelete: Cascade)
  description  String
  amount       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Attendance Audit Trail ──────────────────────────────────────

/// Immutable audit record for ADMIN/ACADEMICS attendance edits.
/// Every edit produces one row. Audit records must not be edited or deleted through the application.
model AttendanceAuditLog {
  id                   String           @id @default(cuid())
  studentAttendanceId  String           @unique
  studentAttendance    StudentAttendance @relation(fields: [studentAttendanceId], references: [id], onDelete: Cascade)
  editedById           String
  editedBy             User             @relation(fields: [editedById], references: [id], onDelete: Restrict)
  editedByRole         Role
  previousStatus       AttendanceStatus
  newStatus            AttendanceStatus
  createdAt            DateTime         @default(now())

  @@index([studentAttendanceId])
}

// ─── School Settings ─────────────────────────────────────────────────

/// Singleton model for school identity configuration.
/// Only one row should exist — enforced at application level, not a DB constraint.
/// Stores school name, address, contact info, and logo path.
model SchoolSettings {
  id             String  @id @default(cuid())
  schoolName     String  @default("[SCHOOL NAME]")
  address        String  @default("")
  phone          String  @default("")
  email          String  @default("")
  principalName  String  @default("")
  logoPath       String? // relative path to uploaded logo file

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Document Templates ─────────────────────────────────────────────

/// Visual template for document print layout.
model DocumentTemplate {
  id                 String   @id @default(cuid())
  type               DocumentTemplateType
  originalFileUrl    String
  backgroundImageUrl String
  uploadedBy         String
  uploader           User     @relation(fields: [uploadedBy], references: [id])
  isActive           Boolean  @default(false)

  fields          TemplateField[]
  tableRegions    TemplateTableRegion[]
  certificates    Certificate[]
  reportCards     ReportCard[]
  feeChallans     FeeChallan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
}

/// A single field placement on a template.
model TemplateField {
  id         String @id @default(cuid())
  templateId String
  template   DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fieldKey   String
  xPercent   Float
  yPercent   Float
  widthPercent  Float?  // nullable — when null, field auto-sizes to content
  heightPercent Float?  // nullable — when null, field auto-sizes to content
  fontSize   Int
  fontFamily String?   // CSS font family — e.g. 'serif', 'Georgia', 'Times New Roman'
  fontColor  String?   // CSS color — e.g. '#000000', '#0F172A'
  fontWeight  String?   // CSS font weight — 'normal', 'bold'
  fontStyle   String?   // CSS font style — 'normal', 'italic'
  textDecoration String? // CSS text decoration — 'none', 'underline'
  textAlign  String @default("left")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}

/// A variable-length table region on a template.
model TemplateTableRegion {
  id               String @id @default(cuid())
  templateId       String
  template         DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  anchorXPercent   Float
  anchorYPercent   Float
  rowHeightPercent Float
  columns          Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId])
}
