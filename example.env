# School LMS — environment template.
# Copy this file to .env and fill in real values. Never commit .env or any
# real credential (see .gitignore).

# Neon Postgres connection string (Prisma). Required for auth and every data
# route. Create a database in the Neon console and paste its connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# NextAuth (v4) session signing secret. Generate with:
#   openssl rand -base64 32
# In local development NextAuth runs with a warning if this is unset; set it
# for the preview and it is required in production.
NEXTAUTH_SECRET=""

# Canonical URL of the app. http://localhost:3000 in local development; set to
# the deployed Vercel URL in production so auth callbacks resolve correctly.
NEXTAUTH_URL="http://localhost:3000"
